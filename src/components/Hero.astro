---
import Picture from './Picture.astro';
import { linkAttrs } from '../lib/links';
import { withBase } from '../lib/base';

const {
  variant = 'photo',
  image = withBase('/assets/brand/nw01ffd_home_banner.jpg'),
  kicker = 'Perth-wide GPS flyer distribution',
  title = 'Freaky Flyer Delivery',
  text = '',
  primaryHref = undefined,
  primaryText = 'Get a Quote',
  secondaryHref = undefined,
  secondaryText = 'View Pricing',
} = Astro.props;

const hasBodySlot = Astro.slots.has('default');
const hasActionsSlot = Astro.slots.has('actions');
const primaryHrefResolved = primaryHref ? withBase(primaryHref) : undefined;
const secondaryHrefResolved = secondaryHref
  ? withBase(secondaryHref)
  : undefined;
const primaryAttrs = primaryHrefResolved ? linkAttrs(primaryHrefResolved) : {};
const secondaryAttrs = secondaryHrefResolved
  ? linkAttrs(secondaryHrefResolved)
  : {};
const showGradientBackdrop = variant !== 'photo';
---

<section
  class={`hero section ${variant === 'photo' ? 'angled-top' : ''} hero--${variant}`}
>
  {
    variant === 'photo' && (
      <>
        <div class="hero__media" aria-hidden="true">
          <Picture
            src={image}
            alt=""
            sizes="100vw"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="hero__overlay" />
      </>
    )
  }
  {showGradientBackdrop && <div class="hero__backdrop" aria-hidden="true" />}
  <div class="container hero__content">
    {kicker && <p class="hero__kicker">{kicker}</p>}
    {title && <h1 class="hero__title">{title}</h1>}
    {
      hasBodySlot ? (
        <div class="hero__body">
          <slot />
        </div>
      ) : (
        text && <p class="hero__text">{text}</p>
      )
    }
    {
      (hasActionsSlot || primaryHref || secondaryHref) && (
        <div class="hero__actions">
          {hasActionsSlot ? (
            <slot name="actions" />
          ) : (
            <>
              {primaryHrefResolved && (
                <a
                  href={primaryHrefResolved}
                  class="button primary"
                  {...primaryAttrs}
                >
                  {primaryText}
                </a>
              )}
              {secondaryHrefResolved && (
                <a
                  href={secondaryHrefResolved}
                  class="button outline"
                  {...secondaryAttrs}
                >
                  {secondaryText}
                </a>
              )}
            </>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    color: #fff;
    overflow: hidden;
    --hero-vertical-padding: clamp(30px, 5vw, calc(var(--space-16) * 0.65));
    min-height: clamp(255px, 38vh, 340px);
    display: flex;
    align-items: center;
  }

  .hero.section {
    padding: 0;
  }

  .hero--photo {
    align-items: center;
  }

  .hero--compact {
    background:
      radial-gradient(
        1200px 600px at 0% 0%,
        rgba(255, 255, 255, 0.12),
        transparent 60%
      ),
      radial-gradient(
        1200px 600px at 100% 0%,
        rgba(137, 4, 11, 0.22),
        transparent 65%
      ),
      linear-gradient(180deg, #2a1216 0%, #14090c 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(
        900px 600px at 0% 0%,
        rgba(255, 255, 255, 0.08),
        transparent 60%
      ),
      linear-gradient(180deg, rgba(28, 10, 13, 0.9), rgba(12, 7, 9, 0.98));
  }

  .hero--compact .hero__backdrop {
    background:
      radial-gradient(
        1200px 600px at 0% 0%,
        rgba(255, 255, 255, 0.12),
        transparent 60%
      ),
      radial-gradient(
        1200px 600px at 100% 0%,
        rgba(137, 4, 11, 0.22),
        transparent 65%
      ),
      linear-gradient(180deg, #2a1216 0%, #14090c 100%);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__media picture,
  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      220deg,
      rgba(11, 12, 16, 0.15) 0%,
      rgba(6, 8, 15, 0.92) 60%,
      rgba(137, 4, 11, 0.82) 100%
    );
    z-index: 1;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--space-4);
    padding: var(--hero-vertical-padding) 0;
    max-width: min(960px, 100%);
    width: 100%;
  }

  .hero--photo .hero__content {
    display: flex;
    flex-direction: column;
  }

  .hero__kicker {
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0;
    font-size: 0.9rem;
  }

  .hero__title {
    color: #fff;
    margin: 0;
  }

  .hero__body {
    display: grid;
    gap: var(--space-3);
  }

  .hero__body :is(p, h2, h3) {
    margin: 0;
    max-width: 65ch;
    line-height: 1.7;
  }

  .hero__text {
    margin: 0;
    max-width: 65ch;
    line-height: 1.7;
  }

  .hero__subtitle {
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .hero__actions .button {
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.25);
  }

  :global(.hero__actions .button.outline) {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.08);
  }

  :global(.hero__actions .button.outline:hover) {
    background: rgba(255, 255, 255, 0.18);
    border-color: #fff;
  }

  @media (max-width: 720px) {
    .hero {
      text-align: center;
    }

    .hero__content {
      align-items: center;
    }

    .hero__body {
      width: 100%;
    }

    .hero__actions {
      justify-content: center;
    }
  }
</style>
