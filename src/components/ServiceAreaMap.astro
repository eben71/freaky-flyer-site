---
import serviceAreaScript from '../scripts/service-area-map.js?url';

const searchId = 'service-area-search';
const helperId = 'service-area-search-help';
const statusId = 'service-area-status';
---

<div class="service-area-map-widget" data-service-area-root>
  <div class="service-area-map-widget__controls">
    <label class="service-area-map-widget__label" for={searchId}>
      Search for a suburb or postcode
    </label>
    <input
      id={searchId}
      class="service-area-map-widget__input"
      type="text"
      name="service-area-search"
      inputmode="search"
      autocomplete="off"
      spellcheck="false"
      placeholder="Start typing..."
      aria-describedby={helperId}
      data-service-area-input
    />
    <p id={helperId} class="service-area-map-widget__hint">
      Start typing to filter more than 240 Western Australian suburbs and
      highlight their general location on the map.
    </p>
    <div class="service-area-map-widget__results-wrapper">
      <ul
        class="service-area-map-widget__results"
        role="listbox"
        aria-label="Matching suburbs"
        data-service-area-results
      >
      </ul>
      <p class="service-area-map-widget__empty" data-service-area-empty>
        Enter at least two letters or a postcode to see available suburbs.
      </p>
    </div>
    <p
      id={statusId}
      class="service-area-map-widget__status"
      aria-live="polite"
      data-service-area-status
    >
    </p>
  </div>
  <div
    class="service-area-map-widget__map"
    role="region"
    aria-label="Interactive service area map"
    data-service-area-map
  >
    <div class="service-area-map-widget__canvas" data-service-area-canvas></div>
    <div class="service-area-map-widget__loader" data-service-area-loader>
      Loading map...
    </div>
    <div
      class="service-area-map-widget__zoom"
      role="group"
      aria-label="Map zoom controls"
    >
      <button
        type="button"
        class="service-area-map-widget__zoom-button"
        data-service-area-zoom-in
        aria-label="Zoom in"
      >
        +
      </button>
      <button
        type="button"
        class="service-area-map-widget__zoom-button"
        data-service-area-zoom-out
        aria-label="Zoom out"
      >
        -
      </button>
    </div>
  </div>
</div>
<script type="module" src={serviceAreaScript}></script>

<style>
  .service-area-map-widget {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-6);
    border-radius: calc(var(--radius, 14px) * 1.1);
    background: #fff;
    box-shadow: var(--shadow);
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    align-items: start;
  }

  .service-area-map-widget__controls {
    display: grid;
    gap: var(--space-3);
  }

  .service-area-map-widget__label {
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .service-area-map-widget__input {
    padding: var(--space-3);
    border-radius: 10px;
    border: 2px solid rgba(17, 24, 39, 0.12);
    font-size: 1rem;
    width: 100%;
    transition: border-color 0.2s ease;
  }

  .service-area-map-widget__input:focus {
    border-color: var(--accent, #89040b);
    outline: none;
    box-shadow: 0 0 0 3px rgba(137, 4, 11, 0.15);
  }

  .service-area-map-widget__hint {
    margin: 0;
    color: var(--muted, #4b5563);
    font-size: 0.95rem;
  }

  .service-area-map-widget__results-wrapper {
    border: 1px solid rgba(17, 24, 39, 0.08);
    border-radius: var(--radius);
    padding: var(--space-2);
    background: var(--surface, #f5f6f8);
  }

  .service-area-map-widget__results {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 320px;
    overflow: auto;
    display: grid;
    gap: var(--space-2);
  }

  .service-area-map-widget__result-button {
    width: 100%;
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-radius: 10px;
    border: 2px solid transparent;
    background: #fff;
    font-size: 0.95rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .service-area-map-widget__result-button:hover,
  .service-area-map-widget__result-button:focus-visible {
    border-color: rgba(137, 4, 11, 0.25);
  }

  .service-area-map-widget__result-button.is-selected {
    background: rgba(137, 4, 11, 0.08);
    border-color: rgba(137, 4, 11, 0.5);
  }

  .service-area-map-widget__empty {
    margin: var(--space-2) 0 0;
    font-size: 0.95rem;
    color: var(--muted, #4b5563);
  }

  .service-area-map-widget__status {
    margin: 0;
    font-size: 0.95rem;
    color: var(--accent, #89040b);
    min-height: 1.25rem;
  }

  .service-area-map-widget__map {
    min-height: 520px;
    border-radius: calc(var(--radius, 14px) * 1.1);
    overflow: hidden;
    position: relative;
    background: linear-gradient(135deg, #f3f4f6, #e5e7eb);
  }

  .service-area-map-widget__canvas {
    position: absolute;
    inset: 0;
  }

  .service-area-map-widget__canvas :global(.leaflet-container) {
    width: 100%;
    height: 100%;
    font: inherit;
  }

  .service-area-map-widget__canvas :global(.leaflet-control) {
    font-size: 0.75rem;
  }

  .service-area-map-widget__canvas :global(.leaflet-control-attribution) {
    background: rgba(255, 255, 255, 0.9);
    color: #111827;
  }

  .service-area-map-widget__loader {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted, #4b5563);
    background: repeating-linear-gradient(
      45deg,
      rgba(255, 255, 255, 0.85),
      rgba(255, 255, 255, 0.85) 16px,
      rgba(229, 231, 235, 0.85) 16px,
      rgba(229, 231, 235, 0.85) 32px
    );
  }

  .service-area-map-widget__zoom {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    z-index: 5;
  }

  .service-area-map-widget__zoom-button {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    border: 2px solid rgba(17, 24, 39, 0.12);
    background: rgba(255, 255, 255, 0.95);
    font-size: 1.35rem;
    font-weight: 600;
    color: #111827;
    line-height: 1;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
    display: grid;
    place-items: center;
  }

  .service-area-map-widget__zoom-button:hover,
  .service-area-map-widget__zoom-button:focus-visible {
    border-color: var(--accent, #89040b);
    box-shadow: 0 0 0 2px rgba(137, 4, 11, 0.15);
  }

  @media (max-width: 960px) {
    .service-area-map-widget {
      grid-template-columns: 1fr;
    }

    .service-area-map-widget__map {
      min-height: 420px;
    }
  }
</style>
